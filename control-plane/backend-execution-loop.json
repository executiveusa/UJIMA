{
  "version": "1.0.0",
  "decision": "backend_first_public_frontend_frozen",
  "public_frontend": {
    "repository": "executiveusa/asc3nd-brand-site",
    "state": "frozen",
    "allowed_without_explicit_owner_approval": ["read_only_inspection", "contract_discovery", "outage_recovery_planning"],
    "forbidden_without_explicit_owner_approval": ["redesign", "copy_change", "style_change", "layout_change", "feature_addition", "production_frontend_migration"]
  },
  "laws": {
    "canonical_truth": "ICM",
    "one_boss_per_truth": true,
    "builder_cannot_final_approve": true,
    "serialized_slice_merges": true,
    "completion_requires_evidence": true,
    "maximum_active_workstreams": 3,
    "money_filter": ["direct_outcome_or_funding", "removes_outcome_blocker", "required_safety_or_reliability", "backlog"]
  },
  "quality_stack": {
    "unlazy": {
      "source": "https://github.com/Leonxlnx/unlazy",
      "required_for": "every substantial slice",
      "enforcement": ["acceptance_ledger_before_build", "checks_are_runnable", "reverify_before_completion", "evidence_only_claims"]
    },
    "ponytail": {
      "source": "https://github.com/DietrichGebert/ponytail",
      "required_for": "engineering changes",
      "enforcement": ["inspect_first", "reuse_before_add", "native_or_existing_before_dependency", "never_remove_safety_for_less_code"]
    },
    "humanizer": {
      "source": "https://github.com/blader/humanizer",
      "required_for": "late_stage_public_or_client_prose_only",
      "enforcement": ["facts_locked_first", "no_claim_invention", "no_schema_or_policy_rewrites"]
    },
    "ralphy": {
      "source": "https://github.com/michaelshimeles/ralphy",
      "required_for": "optional bounded coding execution",
      "enforcement": ["isolated_branch_or_worktree", "create_pr", "tests_enabled", "no_dangerous_permission_modes", "no_direct_main"]
    },
    "gauntlet_loop": {
      "source": "https://github.com/robonuggets/gauntlet-loop",
      "required_for": "release checkpoint",
      "enforcement": ["named_fetchable_comparable_bar", "fresh_critic_role", "binary_pass_or_revise", "no_fixed_round_self_approval"]
    },
    "claude_seo": {
      "source": "https://github.com/AgriciDaniel/claude-seo",
      "required_for": "visibility lane only",
      "enforcement": ["primary_source_grounding", "falsifiable_recommendations", "no_truth_ownership", "measure_outcomes_not_activity"]
    },
    "emilkowalski_skills": {
      "source": "https://github.com/emilkowalski/skills",
      "required_for": "client_facing_ui_only",
      "enforcement": ["product_interaction_review", "native_or_trusted_ui_choices", "motion_only_when_useful", "public_frontend_freeze_overrides_skill"]
    }
  },
  "slice_loop": [
    "read_scope_and_icm",
    "refresh_main_and_conflict_check",
    "create_isolated_slice_branch",
    "write_acceptance_ledger",
    "run_ponytail_minimum_check",
    "implement_owned_paths_only",
    "run_tests_and_reverify",
    "run_specialist_checks_if_lane_requires",
    "run_independent_gauntlet_checkpoint",
    "produce_checkpoint_artifact",
    "open_pr",
    "verify_no_merge_conflict",
    "verify_required_ci",
    "merge_one_pr_only",
    "refresh_main",
    "update_icm_and_continue"
  ],
  "slices": [
    {"id":"01","name":"reality-and-ownership","outcome":"current-system map, ownership map, risk and migration inventory"},
    {"id":"02","name":"canonical-asc3nd-icm","outcome":"portable cold-agent-readable ASC3ND organization brain"},
    {"id":"03","name":"portable-data-model","outcome":"file-based schemas for all critical operational domains"},
    {"id":"04","name":"supabase-schema-as-code","outcome":"versioned schema, migrations, RLS, seed and rollback contracts"},
    {"id":"05","name":"backup-export-restore","outcome":"portable backup/export/restore and disposable recovery proof"},
    {"id":"06","name":"identity-crm-participation","outcome":"canonical people, roles, consent, participation and follow-up model"},
    {"id":"07","name":"domain-engines","outcome":"typed grant, CRM, content, SEO, analytics and approval engine contracts"},
    {"id":"08","name":"github-automation-fabric","outcome":"repeatable CI, dispatch, schedule, artifact and recovery workflows"},
    {"id":"09","name":"recovery-cold-agent-gauntlet","outcome":"fresh-agent recovery walk test with evidence"},
    {"id":"10","name":"backend-integration-freeze","outcome":"stable backend contracts and explicit frontend handoff without redesign"}
  ],
  "stop_conditions": ["human_fact_required", "human_approval_required", "credential_or_access_blocker", "policy_or_risk_ambiguity", "public_frontend_unlock_required"]
}
