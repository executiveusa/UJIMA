{
  "id": "open-interpreter",
  "role": "computer_operations",
  "version": "0.1.0",
  "repository": "executiveusa/open-interpreter-fork",
  "capabilities": [
    "computer.shell.execute",
    "computer.browser.control",
    "computer.desktop.control",
    "computer.files.write"
  ],
  "interfaces": {
    "api": false,
    "mcp": false,
    "cli": true,
    "browser": false,
    "gui": false
  },
  "owns": [
    "computer_execution_sessions"
  ],
  "requires_approval": [
    "destructive.file.operation",
    "production.infrastructure.change",
    "external.publish"
  ],
  "health": {
    "mode": "heartbeat",
    "interval_seconds": 60
  },
  "events": {
    "emits": ["work.started", "work.blocked", "artifact.created", "verification.failed", "work.completed"],
    "consumes": ["work.assigned", "approval.requested"]
  },
  "evidence": {
    "receipt_version": "v0"
  },
  "metadata": {
    "repo_manifest_path": ".agenix/capabilities.json",
    "merged_sha": "b22311637cf11888f2cc0975617867483dc25ed1",
    "execution_role": "last-mile local computer actuator",
    "network_policy": "outbound-worker-default",
    "filesystem_policy": "approved-roots-only",
    "enabled_interface_order": ["cli"],
    "browser_status": "disabled until bounded Hive worker enforces routing policy",
    "gui_status": "disabled until bounded Hive worker enforces fallback policy",
    "gui_policy": "fallback-after-api-mcp-cli-structured-browser",
    "mcp_status": "not marked available for this legacy fork until runtime probe",
    "vercel_status": "legacy project configuration failure deferred because this provider is a local worker"
  }
}
