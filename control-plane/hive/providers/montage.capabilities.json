{
  "id": "montage",
  "role": "film_studio",
  "version": "0.1.0",
  "repository": "executiveusa/pauli-montage-video-agent",
  "capabilities": [
    "video.ingest",
    "video.transcribe",
    "video.edit.apply",
    "video.render",
    "video.verify"
  ],
  "interfaces": {
    "api": "http://127.0.0.1:4788",
    "mcp": false,
    "cli": false,
    "browser": false,
    "gui": false
  },
  "owns": [
    "video_project_state"
  ],
  "requires_approval": [
    "external.publish",
    "source.delete",
    "major.production.path.change"
  ],
  "health": {
    "mode": "http",
    "target": "http://127.0.0.1:4788/health",
    "interval_seconds": 60
  },
  "events": {
    "emits": ["work.started", "work.blocked", "artifact.created", "review.required", "video.render.ready", "work.completed"],
    "consumes": ["work.assigned", "approval.requested"]
  },
  "evidence": {
    "receipt_version": "v0"
  },
  "metadata": {
    "repo_manifest_path": ".agenix/hive-provider.json",
    "merged_sha": "3ae561888599a759aef98caf3b80c15222e2c3fc",
    "registry_scope": "agenix_hive_external",
    "montage_runtime_registry": "yappy_clipz.capabilities.default_registry",
    "canonical_project_contract": "StudioProject v1",
    "enabled_interface_order": ["api"],
    "director_status": "video.edit.propose excluded until Director proposal engine is implemented",
    "mcp_status": "not claimed until current media capabilities are registered through the existing Montage registry and runtime-probed",
    "source_media_immutable": true
  }
}
