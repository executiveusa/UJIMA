{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asc3nd.org/schemas/social-purpose-mission-envelope.schema.json",
  "title": "Social Purpose OS Mission Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "task_id",
    "tenant_id",
    "owner_repository",
    "lane",
    "objective",
    "risk_tier",
    "acceptance_criteria",
    "allowed_capabilities",
    "denied_capabilities",
    "approval",
    "evidence_contract"
  ],
  "properties": {
    "version": {"const": "1.0"},
    "task_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "requested_by": {"type": ["string", "null"]},
    "owner_repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "lane": {
      "type": "string",
      "enum": ["grants", "social", "seo_visibility", "frontend", "engineering", "crm", "analytics", "brand", "delivery"]
    },
    "objective": {"type": "string", "minLength": 1},
    "executor": {
      "type": ["string", "null"],
      "enum": [null, "grant-agent", "hermes", "firstmate", "ralphy", "openhands", "human"]
    },
    "risk_tier": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "description": "0 read, 1 internal write, 2 reversible external, 3 consequential"
    },
    "inputs": {"type": "array", "items": {"type": "string"}, "default": []},
    "allowed_paths": {"type": "array", "items": {"type": "string"}, "default": []},
    "allowed_domains": {"type": "array", "items": {"type": "string"}, "default": []},
    "allowed_capabilities": {"type": "array", "items": {"type": "string"}},
    "denied_capabilities": {"type": "array", "items": {"type": "string"}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "classes"],
      "properties": {
        "required": {"type": "boolean"},
        "classes": {"type": "array", "items": {"type": "string"}},
        "approval_id": {"type": ["string", "null"]}
      }
    },
    "rollback": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "required": {"type": "boolean"},
        "target": {"type": ["string", "null"]}
      }
    },
    "evidence_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "return_to_icm"],
      "properties": {
        "required": {"type": "array", "items": {"type": "string"}},
        "return_to_icm": {"type": "boolean"}
      }
    }
  }
}